[Unit]
Description=Local GBrain embedding endpoint (Ollama)
After=default.target
StartLimitIntervalSec=60s

[Service]
Type=simple
Environment=OLLAMA_HOST=127.0.0.1:11434
Environment=OLLAMA_MODELS=/home/sungin/.local/gbrain-endpoints/ollama-models
Environment=CUDA_VISIBLE_DEVICES=0
ExecStart=/home/sungin/.local/gbrain-endpoints/ollama/bin/ollama serve
ExecStartPost=/home/sungin/.local/gbrain-endpoints/bin/check-embedding.sh
Restart=on-failure
RestartSec=5s
StartLimitBurst=5
LogRateLimitIntervalSec=30s
LogRateLimitBurst=50
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
